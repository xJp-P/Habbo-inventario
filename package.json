{
  "name": "habbo-inventario",
  "productName": "Habbo Inventario",
  "version": "1.0.0",
  "description": "Inventario de compra y venta de furnis para Habbo.es con base de datos en Supabase: stock, costos, ganancias y compras en tiempo real desde SniperMercadillo.",
  "author": "xJp-P",
  "license": "MIT",
  "homepage": "https://github.com/xJp-P/Habbo-inventario",
  "repository": {
    "type": "git",
    "url": "https://github.com/xJp-P/Habbo-inventario.git"
  },
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "web": "node scripts/servidor-web.js",
    "demo": "node scripts/servidor-web.js --demo",
    "migrar": "node scripts/migracion.js",
    "verificar": "node scripts/verificar.js",
    "supabase:probar": "node scripts/probar-supabase.js",
    "prueba-arranque": "electron . --prueba-arranque",
    "simular-actualizacion": "electron . --simular-actualizacion",
    "build:win": "electron-builder --win nsis --x64",
    "build:mac": "electron-builder --mac",
    "build:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.xjpp.habboinventario",
    "productName": "Habbo Inventario",
    "copyright": "Copyright © 2026 xJp-P",
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "public/**/*",
      "supabase/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Habbo-Inventario-Windows-${version}.${ext}",
      "icon": "recursos/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Habbo Inventario",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "recursos/icon.ico",
      "uninstallerIcon": "recursos/icon.ico",
      "installerHeaderIcon": "recursos/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Habbo-Inventario-Mac-${version}-${arch}.${ext}",
      "icon": "recursos/icon.png"
    },
    "dmg": {
      "title": "Habbo Inventario ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "xJp-P",
      "repo": "Habbo-inventario",
      "releaseType": "draft"
    }
  }
}
